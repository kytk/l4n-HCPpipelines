# alias for xdg-open
alias open='xdg-open &> /dev/null'

# shopt
shopt -s direxpand
shopt -s autocd

# Disable screensaver
xset s off

# XDG Runtime Directory
export XDG_RUNTIME_DIR="/tmp/runtime-brain"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Qt Session Management - Disable to avoid VNC authentication errors
unset SESSION_MANAGER
export QT_X11_NO_MITSHM=1
export QT_GRAPHICSSYSTEM=native
export QT_X11_NO_XIM=1

# MRIcroGL
# Resources/ is not added: the only executable in it was dcm2niix, and that is
# now a link to /usr/local/dcm2niix/dcm2niix, which is on PATH just below.
export PATH=/usr/local/MRIcroGL:$PATH

# dcm2niix
export PATH=/usr/local/dcm2niix:$PATH

# Connectome Workbench (official build; bin_linux64/* are wrappers that
# resolve their own location, so this directory is the one to use)
export PATH=/usr/local/workbench/bin_linux64:$PATH

#FreeSurfer 6.0.1
export SUBJECTS_DIR=~/freesurfer/6.0.1/subjects
export FREESURFER_HOME=/usr/local/freesurfer/6.0.1
source $FREESURFER_HOME/SetUpFreeSurfer.sh

# FSL Setup
FSLDIR=/usr/local/fsl
PATH=${FSLDIR}/share/fsl/bin:${PATH}
export FSLDIR PATH
. ${FSLDIR}/etc/fslconf/fsl.sh

# fsl_sub: submit to Slurm when slurm-init.sh started it. The file is written
# only once Slurm is up; without it fsl_sub runs jobs in place.
if [ -f /etc/fsl_sub.yml ]; then
    export FSLSUB_CONF=/etc/fsl_sub.yml
fi

# Python3
# /usr/bin comes before the FSL conda bin/ that SetUpFreeSurfer.sh adds (it
# ships its own python3, curl, ...), and /opt/venv/bin (Python 3.12 venv,
# the image's single Python environment) comes before everything.
export PATH=/opt/venv/bin:/usr/bin/:$PATH


